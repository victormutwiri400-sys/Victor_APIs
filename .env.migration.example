# ---------------------------------------------------------------------
# Copy this file to `.env.migration` and fill in your REAL values.
# `.env.migration` is git-ignored and must NEVER be committed.
# The migration script also accepts plain environment variables:
#   $env:MYSQL_PASSWORD="..."   (PowerShell)
# ---------------------------------------------------------------------

# --- MySQL / MariaDB (AlwaysData) ---
MYSQL_HOST=mysql-victordesigner.alwaysdata.net
MYSQL_USER=victordesigner
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=victordesigner_fullstack

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# --- Optional overrides ---
# Base URL where the legacy images are served (audit-verified).
# MIGRATION_STATIC_BASE_URL=https://victordesigner.alwaysdata.net/static
