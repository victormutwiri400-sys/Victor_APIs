diff --git a/src/utils/imageUrl.js b/src/utils/imageUrl.js
new file mode 100644
index 0000000..155a3e9
--- /dev/null
+++ b/src/utils/imageUrl.js
@@ -0,0 +1,32 @@
+/**
+ * Shared image-URL resolver for legacy local filenames and Cloudinary URLs.
+ *
+ * After the Cloudinary migration every `photo` field returned by the API can be
+ * either:
+ *   - a full URL (e.g. https://res.cloudinary.com/...)  -> returned as-is
+ *   - a legacy bare filename (e.g. 'master5.jpg')       -> resolved against
+ *     the legacy AlwaysData static folder.
+ *
+ * `folder` must be one of the legacy static sub-folders:
+ *   "images" (dining), "gallery", "rooms", "profiles".
+ *
+ * `{ lower }` only affects legacy filenames (historical behavior of Dining);
+ * full URLs are NEVER lowercased or re-prefixed.
+ */
+const STATIC_BASE = "https://victordesigner.alwaysdata.net/static";
+
+export function buildImageUrl(photo, folder, { lower = false } = {}) {
+  if (!photo) return "";
+  const value = String(photo).trim();
+  if (/^https?:\/\//i.test(value)) return value; // full URL: use as-is
+  let name = value;
+  if (lower) name = name.toLowerCase();
+  return `${STATIC_BASE}/${folder}/${name}`;
+}
+
+export const IMAGE_FOLDERS = {
+  dining: "images",
+  gallery: "gallery",
+  rooms: "rooms",
+  profiles: "profiles",
+};
