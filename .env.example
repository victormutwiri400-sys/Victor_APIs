# ---------------------------------------------------------------------
# BACKEND environment variables for api.py (Flask).
#
# This file is a TEMPLATE ONLY — it must contain placeholders only.
# The Flask app does NOT read .env files automatically; it reads real
# environment variables that the hosting platform (AlwaysData) provides.
#
# LOCAL DEVELOPMENT (PowerShell):
#   $env:MYSQL_PASSWORD="replace_with_your_local_secret"
#   ... (set everything below) ...
#   python api.py
#
# ALWAYSData (production): set each variable in
#   AlwaysData Admin -> Sites -> your site -> Edit -> Environment variables
# then restart the site. Real values must be entered in the AlwaysData
# dashboard, never committed here.
# ---------------------------------------------------------------------

# --- Flask ---
# Optional but strongly recommended once sessions/tokens are used.
# FLASK_SECRET_KEY=replace_with_a_long_random_string

# --- MySQL / MariaDB (AlwaysData) ---
MYSQL_HOST=mysql-victordesigner.alwaysdata.net
MYSQL_USER=victordesigner
MYSQL_PASSWORD=replace_with_your_database_password
MYSQL_DATABASE=victordesigner_fullstack

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=replace_with_your_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret

# --- Safaricom M-Pesa (Daraja API) ---
MPESA_CONSUMER_KEY=replace_with_your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=replace_with_your_mpesa_consumer_secret
MPESA_PASSKEY=replace_with_your_mpesa_passkey
